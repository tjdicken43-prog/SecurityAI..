# Copy this file to .env and fill in what you need. Nothing in this repo
# reads secrets from anywhere else.

# --- Required for the demo site + checkout to run at all ---
DOMAIN=http://localhost:4242

# --- Required for real payments (checkout.html) ---
# Get a test-mode key free at dashboard.stripe.com — starts with sk_test_
STRIPE_SECRET_KEY=
# From `stripe listen` if testing webhooks locally, otherwise from the
# Stripe dashboard's webhook settings once you have a live endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Required for persistent monitoring (monitor.html) to analyze anything ---
# Real key from console.anthropic.com. The browser demo on securityai.html
# does NOT need this (claude.ai proxies that call) — this standalone Node
# server does.
ANTHROPIC_API_KEY=

# --- Optional: email alerts (skipped gracefully if left blank) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional: where the support form on securityai.html forwards to ---
# Falls back to SMTP_USER if left blank. Needs SMTP_HOST configured above
# to actually send — otherwise messages are just logged to the server
# console instead of emailed.
SUPPORT_EMAIL=

# --- Optional: SMS alerts via Twilio (skipped gracefully if left blank) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
